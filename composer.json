{
    "name": "c975l/shop-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for e-commerce on the c975L core — product catalog with categories, media, downloadable files and affinity recommendations. Checkout is delegated to c975l/payment-bundle.",
    "keywords": [
        "symfony",
        "bundle"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Laurent Marquet",
            "email": "laurent.marquet@laposte.net",
            "homepage": "https://github.com/LaurentMarquet",
            "role": "Developer"
        },
        {
            "name": "975L Community",
            "homepage": "https://github.com/975L"
        }
    ],
    "require": {
        "php": ">=8.4",
        "c975l/core-bundle": "^1.21",
        "c975l/payment-bundle": "^6.7",
        "doctrine/orm": "^3.6",
        "easycorp/easyadmin-bundle": "^5.1",
        "imagine/imagine": "^1.5",
        "symfony/asset": "^8.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/rate-limiter": "^8.1",
        "symfony/security-bundle": "^8.0",
        "symfony/string": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/ux-live-component": "^3.3",
        "symfony/validator": "^8.0",
        "vich/uploader-bundle": "^2.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "c975L\\ShopBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "c975L\\ShopBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "audit-deps": "composer audit --abandoned=report",
        "cs": "phpcs -q",
        "fixer": "php-cs-fixer check --diff",
        "stan": "phpstan analyse --no-progress",
        "rector": "rector process --dry-run",
        "mess": "phpmd src text phpmd.xml.dist --ignore-errors-on-exit --report-file .phpmd-report.log; s=$?; grep -E \"^(/|[[:space:]]*-)\" .phpmd-report.log; exit $s",
        "lizard-ccn": "lizard -l php -C 14 -w src",
        "lizard-nloc": "find src -name '*.php' ! -name '*CrudController.php' ! -name '*Type.php' | xargs lizard -l php -T nloc=99 -C 999 -a 999 -w",
        "lizard": [
            "@lizard-ccn",
            "@lizard-nloc"
        ],
        "test": "phpunit",
        "qa": [
            "@audit-deps",
            "@cs",
            "@fixer",
            "@stan",
            "@rector",
            "@mess",
            "@lizard",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "audit-deps": "Avis de sécurité Packagist sur les dépendances résolues (OWASP A06) - les paquets abandonnés sont signalés, sans faire échouer",
        "cs": "PSR-12 (phpcs)",
        "fixer": "Standard Symfony (php-cs-fixer)",
        "stan": "Analyse statique du bundle, level 5",
        "test": "Suite PHPUnit",
        "qa": "Tous les contrôles de la CI, dans l'ordre - voir bin/ci.sh pour les rejouer sur des dépendances fraîches"
    },
    "support": {
        "email": "contact@975l.com",
        "source": "https://github.com/975L/ShopBundle",
        "issues": "https://github.com/975L/ShopBundle/issues"
    }
}
