{# Adapter for the dynamic Block system - renders nothing at all when the shop has no category yet, rather than an empty row #}
{% set categories = shop_block_categories(max|default(null)) %}
{% if categories is not empty %}
    {# The page measure and the vertical step, stated here as every other kind states them: dropped on a composed page the block hangs straight under ".blocks", which is "display: contents", so nothing else would measure it #}
    <div class="block-section">
        <div class="section-wrap">
            <twig:c975LShop:Product:Categories categories="{{ categories }}" title="{{ title|default('') }}"/>
        </div>
    </div>
{% endif %}
