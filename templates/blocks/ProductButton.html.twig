{# The label and the url follow the product: renaming it renames the button, where a UiBundle "button" holding both by hand would keep the old wording #}
{% set product = shop_block_product(productSlug|default(null)) %}
{% if product %}
    <twig:c975LShop:Product:Button product="{{ product }}" type="{{ type|default('primary') }}"/>
{% endif %}
