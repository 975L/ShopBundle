{# The live search of the shop's own index, placed wherever a page needs it - the shop's index puts the field in its filter row and states nothing above it, a block naming its own #}
{% if title|default('') is not empty %}
    <h2>{{ title }}</h2>
{% endif %}
<twig:c975LShop:Product:Search categorySlug="{{ categorySlug|default(null) }}"/>
