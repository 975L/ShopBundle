{# The heading is a prop, same as the products grid above it: a "shop_categories" block names its own selection, the product sheet passing none #}
{% set heading = title|default('') is not empty ? title : 'label.categories'|trans({}, 'shop') %}
{% if categories is not empty %}
    <h2 id="category">{{ heading }}</h2>
    <div class="flex-center categories">
        {% for category in categories %}
            <p><a href="{{ path('category_display', {'slug': category.slug}) }}" class="btn btn-small white">{{ category.name }}</a></p>
        {% endfor %}
    </div>
{% endif %}
