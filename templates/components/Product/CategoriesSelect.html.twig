{# The root element carries the Live Component's attributes, so it is written whatever the shop holds - a shop with no category yet simply shows no selector inside it #}
<div {{ attributes }} class="category-selector">
    {% if categories is not empty %}
        {# The name of the field is written above it rather than hidden in its first option: an option disappears as soon as a category is picked, and the visitor no longer knows what the control narrows #}
        <label class="product-filter-label" for="category-select">{{ 'label.category'|trans({}, 'shop') }}</label>
        <select
            id="category-select"
            class="category-select"
            data-model="on(change)|selectedCategory"
            data-action="live#action"
            data-live-action-param="changeCategory"
        >
            {# The whole shop comes first and is what a listing narrowed by nothing shows: a "select a category" placeholder led nowhere and was never the selected one #}
            <option value="all" {% if not selectedCategory or selectedCategory == 'all' %}selected{% endif %}>{{ 'label.shop'|trans({}, 'shop') }}</option>
            {% for category in categories %}
                <option value="{{ category.slug }}" {% if category.slug == selectedCategory %}selected{% endif %}>{{ category.name }}</option>
            {% endfor %}
        </select>
    {% endif %}
</div>
