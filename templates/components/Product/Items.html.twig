<section class="items">
    {% if items is not empty %}
        <div class="product-items">
            {% for item in items %}
                {# The first row opens on arrival, so the sheet never lands on a list of closed drawers #}
                <twig:c975LShop:Product:Item productItem="{{ item }}" open="{{ loop.first }}"/>
            {% endfor %}
        </div>
    {% else %}
        <p class="text text-center lead">{{ 'label.no_item'|trans({}, 'shop') }}</p>
    {% endif %}
</section>
