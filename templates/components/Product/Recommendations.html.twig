{# The heading is a prop, same as the products grid: a "shop_recommendations" block names its own selection, the product sheet passing none #}
{% set heading = title|default('') is not empty ? title : 'label.you_might_also_like'|trans({}, 'shop') %}
{% if recommendations is defined and recommendations is not empty %}
    <section class="recommendations" id="recommendations">
        <div class="recommendations-header">
            <h2>{{ heading }}</h2>
        </div>
        <div class="recommendations-list">
            {% for recommendation in recommendations %}
                <twig:c975LShop:Product:Recommendation recommendation="{{ recommendation }}"/>
            {% endfor %}
        </div>
    </section>
{% endif %}
