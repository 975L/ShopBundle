{# <twig:c975LShop:ProductItem:AddButton productItem="{{ productItem }}" [type="primary"] [quantity="1"]/> #}
{% set type = type | default('primary') %}
{% set quantity = quantity | default(1) %}
{% set disabled = "" %}
{# The price is on the button rather than only above it: it is the last thing read before the click #}
{% set label = 'label.add'|trans({}, 'shop') ~ ' — ' ~ (productItem.price == 0 ? 'label.free'|trans({}, 'shop') : (productItem.price / 100)|format_currency(productItem.currency)) %}

{# Out of stock rather than withdrawn: what is expected back is worth waiting for, where an item capped at 0 was taken off sale and promises nothing. Read from the service rather than compared here, the badge and the alerts answering the same question #}
{% set soldOut = shop_item_sold_out(productItem) %}

{% if productItem.limitedQuantity is same as 0 %}
    {% set disabled = "disabled" %}
    {% set label = 'label.unavailable'|trans({}, 'shop') %}
{% elseif soldOut %}
    {% set disabled = "disabled" %}
    {% set label = 'label.out_of_stock'|trans({}, 'shop') %}
{% endif %}
<button
    {{ disabled }}
    data-action="click->basket#addItem"
    data-type="product"
    data-quantity="{{ quantity }}"
    data-limited="{{ productItem.limitedQuantity|default(0) }}"
    data-ordered="{{ productItem.orderedQuantity|default(0) }}"
    data-item-id="{{ productItem.id }}"
    data-title="{{ productItem.title }}"
    data-alert="success"
    data-text="{{ 'label.added'|trans({}, 'shop') }}"
    class="btn btn-large btn-{{ type }}">
    <twig:c975LUi:Image:Icon src="bundles/c975lshop/icons/basket-shopping.svg" width="24" height="24"/> {{ label }}
</button>

{# A page of its own rather than a form here: this html is cached per fragment, where a form needs a session and a csrf token #}
{% if soldOut %}
    <a href="{{ path('shop_stock_alert_new', {'id': productItem.id}) }}" rel="nofollow" class="btn btn-large btn-secondary">
        <twig:c975LUi:Image:Icon src="bundles/c975lshop/icons/bell.svg" width="24" height="24"/> {{ 'label.stock_alert_notify_me'|trans({}, 'shop') }}
    </a>
{% endif %}
